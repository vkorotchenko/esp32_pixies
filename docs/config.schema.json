{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pixies:config:1",
  "title": "Pixies complete lighting configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledCount", "on", "brightness", "speed", "intensity", "density", "effect", "paletteId", "customPalettes"],
  "properties": {
    "ledCount": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 },
    "on": { "type": "boolean", "default": true },
    "brightness": { "type": "integer", "minimum": 0, "maximum": 100, "default": 25 },
    "speed": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
    "intensity": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
    "density": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
    "effect": { "enum": ["steady", "twinkle", "candle", "breathe", "chase"], "default": "steady" },
    "paletteId": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[a-z0-9_-]+$", "default": "halloween" },
    "customPalettes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "colors"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[a-z0-9_-]+$", "not": { "enum": ["halloween", "christmas"] } },
          "name": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[\\x20-\\x7e]+$" },
          "colors": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
        }
      }
    }
  },
  "$comment": "Additionally IDs must be unique and paletteId must select a built-in or an included custom palette. The firmware rejects all invalid updates atomically. Numeric fields must be integer JSON tokens, not floats/strings/booleans."
}
